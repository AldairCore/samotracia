# Spotify (Fase 2) — https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Last.fm (Fase 2) — https://www.last.fm/api/account/create
# Sugiere grupo por tags de artista para canciones nuevas que no calzan con core-lore.json.
VITE_LASTFM_API_KEY=

# TMDB (Fase 3) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# PostgreSQL (Fase 3)
DB_URL=jdbc:postgresql://localhost:5432/album
DB_USER=album
DB_PASSWORD=
